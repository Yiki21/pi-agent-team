{
  "name": "@yiki21/pi-agent-team",
  "version": "0.5.1",
  "description": "Turn several machines running the Pi coding agent into one team over your tailnet. Three transports (broker / mesh / SWIM), one shared API and conformance suite.",
  "license": "MIT",
  "author": "Yiki21",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "agent-mesh",
    "agent-team",
    "multi-agent",
    "tailscale",
    "coding-agent",
    "swim",
    "memberlist",
    "gossip",
    "subscription",
    "watch"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi-agent-team-broker": "broker.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "broker.mjs",
    "index.ts",
    "docs/",
    "skills/",
    "swim/main.go",
    "swim/go.mod",
    "swim/go.sum",
    "README.md",
    "LICENSE",
    "src/dispatch.js",
    "src/mode.js",
    "src/options.js",
    "src/session.js",
    "src/team-config.js",
    "src/transport-mesh.js",
    "src/transport-swim.js",
    "src/transport.js",
    "src/ws.js",
    "tsconfig.json",
    "src/watch.js"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test --test-timeout=30000 src/ e2e/",
    "test:unit": "node --test --test-timeout=30000 src/",
    "test:e2e": "node --test --test-timeout=30000 e2e/",
    "broker": "node broker.mjs",
    "build:sidecar": "cd swim && go build -o ../.tmp/swim-sidecar .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiki21/pi-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/Yiki21/pi-agent-team/issues"
  },
  "homepage": "https://github.com/Yiki21/pi-agent-team#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0"
  }
}
