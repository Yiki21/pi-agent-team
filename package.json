{
  "name": "pi-agent-team",
  "version": "0.1.0",
  "description": "Turn several machines running the Pi coding agent into one team that talks to itself over your tailnet. Broker + Pi extension + agent skill.",
  "license": "MIT",
  "author": "Yiki21",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "agent-mesh",
    "agent-team",
    "multi-agent",
    "tailscale",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi-agent-team-broker": "./broker.mjs"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "files": [
    "broker.mjs",
    "index.ts",
    "src/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/ e2e/",
    "test:unit": "node --test src/",
    "test:e2e": "node --test e2e/",
    "broker": "node broker.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiki21/pi-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/Yiki21/pi-agent-team/issues"
  },
  "homepage": "https://github.com/Yiki21/pi-agent-team#readme"
}
